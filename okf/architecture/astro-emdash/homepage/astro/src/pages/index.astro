---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/shell/SiteShell.astro';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import HeroSection from '../components/homepage/HeroSection.astro';
import FeatureBlock from '../components/homepage/FeatureBlock.astro';
import FeaturedTours from '../components/homepage/FeaturedTours.astro';
import InfoStrip from '../components/homepage/InfoStrip.astro';
import FeaturedTourHero from '../components/homepage/FeaturedTourHero.astro';
import RentalGrid from '../components/homepage/RentalGrid.astro';
import Testimonial from '../components/homepage/Testimonial.astro';
import Awards from '../components/homepage/Awards.astro';
import ClosingCTA from '../components/homepage/ClosingCTA.astro';
import DealBanner from '../components/homepage/DealBanner.astro';
import shellData from '../content/nav/aot-shell-data.json';
import homepageData from '../content/homepage-data.json';

const business = shellData.business;
const navTree = shellData.primaryNav;
const footerGroups = shellData.footerGroups;
const bookingConfig = shellData.booking;

const { hero, sections } = homepageData;
---

<BaseLayout
  title="Oahu Kayak Rentals & Tours — Active Oahu Tours"
  description="Outdoor adventures on Oahu — kayak rentals, guided tours, e-bike adventures, and beach gear delivered to your door."
  canonical="https://activeoahutours.com/"
>
  <SiteShell
    locale="en"
    currentPath="/"
    pageType="homepage"
    navTree={navTree}
    footerGroups={footerGroups}
    bookingConfig={bookingConfig}
    businessIdentity={business}
  >
    <!-- DEAL BANNER -->
    <Fragment slot="deal-banner">
      <DealBanner code="15OFFGROUPS" />
    </Fragment>

    <!-- HERO -->
    <HeroSection
      h1={hero.h1}
      h2={hero.h2}
      subtext={hero.subtext}
      bookingHref={hero.bookingHref}
      bookingLabel={hero.bookingLabel}
    />

    <!-- INFO STRIP (near top — contact info) -->
    <InfoStrip
      phone="(808)498-1894"
      address="134B Hamakua Dr. Kailua HI 96734"
      note="We take day-of and last minute tour or rental bookings."
    />

    <!-- FEATURED TOURS -->
    <FeaturedTours
      h2="Our Most Popular Experiences"
      tours={sections.find(s => s.id === 'featured-tours')?.tours || []}
    />

    <!-- FEATURE BLOCK -->
    <FeatureBlock
      h2="Kayak and Explore Chinaman's Hat, Kahana Bay, Kawela Bay, Kāneʻohe Bay, Kailua Bay and More"
      intro="We make renting e-bikes, kayaks and exploring Oʻahu a breeze. Pick up kayaks and beach gear at our storefront in Kailua."
      features={[
        {
          id: 'kayak-tours',
          icon: '/wp-content/uploads/2019/06/Self-guided-Tours.png',
          iconAlt: 'Guided Kayak Tours',
          heading: 'Kayak Tours',
          text: 'Enjoy Oʻahu\'s best kayaking routes with an experienced guide, or on your own terms with our pre-planned trips.'
        },
        {
          id: 'rentals',
          icon: '/wp-content/uploads/2019/06/Rentals-2.png',
          iconAlt: 'Beach Gear Rentals',
          heading: 'Kayak Rentals',
          text: 'Rent Kayaks and other beach gear and pick them up at our shop or get them delivered to your address.'
        },
        {
          id: 'ebike',
          icon: '/wp-content/uploads/2022/04/Rentals-3.png',
          iconAlt: 'Need Kayaks Today?',
          heading: 'Electric Bike Rentals & Tours',
          text: 'Ride the best trails and beach paths on Oʻahu with our premium e-bike fleet.'
        }
      ]}
    />

    <!-- E-BIKE ADVENTURE HERO -->
    {(() => {
      const eb = sections.find(s => s.id === 'ebike-adventure');
      return eb ? (
        <FeaturedTourHero
          heading={eb.heading}
          text={eb.text}
          href={eb.href}
          cta={eb.cta}
          image={eb.image}
          imageAlt={eb.imageAlt}
        />
      ) : null;
    })()}

    <!-- POPOIA ADVENTURE HERO -->
    {(() => {
      const pop = sections.find(s => s.id === 'popoia-adventure');
      return pop ? (
        <FeaturedTourHero
          heading={pop.heading}
          text={pop.text}
          href={pop.href}
          cta={pop.cta}
          image={pop.image}
          imageAlt={pop.imageAlt}
        />
      ) : null;
    })()}

    <!-- MOKULUA KAYAK ADVENTURE HERO -->
    {(() => {
      const mok = sections.find(s => s.id === 'mokulua-kayak-adventure');
      return mok ? (
        <FeaturedTourHero
          heading={mok.heading}
          text={mok.text}
          href={mok.href}
          cta={mok.cta}
          image={mok.image}
          imageAlt={mok.imageAlt}
        />
      ) : null;
    })()}

    <!-- RENTAL TYPES GRID -->
    {(() => {
      const rt = sections.find(s => s.id === 'rental-types');
      return rt ? (
        <RentalGrid
          h2={rt.h2}
          categories={rt.categories}
        />
      ) : null;
    })()}

    <!-- TESTIMONIAL -->
    <Testimonial
      quote="Great tour! It was so fun to e-bike, kayak, and see wildlife in one adventure"
      attribution="TripAdvisor Reviewer"
    />

    <!-- AWARDS -->
    {(() => {
      const aw = sections.find(s => s.id === 'awards');
      return aw ? (
        <Awards
          h2={aw.h2}
          awardText={aw.awardText}
          awardImages={aw.awardImages}
        />
      ) : null;
    })()}

    <!-- CLOSING CTA -->
    <ClosingCTA
      h2="Plan Your Oʻahu Kayaking Adventure"
      text="We take day-of and last minute tour or rental bookings. Call us at: (808)498-1894 or visit our shop at 134B Hamakua Dr. Kailua HI 96734"
      phone="(808)498-1894"
      phoneHref="tel:+1-808-498-1894"
    />
  </SiteShell>
</BaseLayout>
