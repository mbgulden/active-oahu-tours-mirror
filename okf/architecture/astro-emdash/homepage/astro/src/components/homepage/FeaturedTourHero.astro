---
interface Props {
  heading: string;
  text: string;
  href: string;
  cta: string;
  image: string;
  imageAlt: string;
  imageSrcset?: string;
  imageSizes?: string;
}

const { heading, text, href, cta, image, imageAlt, imageSrcset, imageSizes = "(max-width: 600px) 100vw, 724px" } = Astro.props;
---
<div class="featured-tour-hero">
  <figure>
    <img loading="lazy" decoding="async" width="724" height="480" src={image} srcset={imageSrcset} sizes={imageSizes} alt={imageAlt} />
  </figure>
  <div class="content">
    <h3>{heading}</h3>
    <p>{text}</p>
    <a href={href} class="btn-secondary">{cta}</a>
  </div>
</div>

<style>
  .featured-tour-hero {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid #e0e0e0;
  }
  .featured-tour-hero:last-child {
    border-bottom: none;
  }
  .featured-tour-hero figure {
    flex: 0 0 300px;
    margin: 0;
  }
  .featured-tour-hero img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 6px;
  }
  .featured-tour-hero .content {
    flex: 1;
  }
  .featured-tour-hero h3 {
    font-size: 1.2rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: #0066cc;
    margin: 0 0 0.5rem;
  }
  .featured-tour-hero p {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.95rem;
    color: #555;
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  .featured-tour-hero .btn-secondary {
    display: inline-block;
    padding: 8px 16px;
    background: #0066cc;
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .featured-tour-hero .btn-secondary:hover {
    background: #004999;
    color: #fff;
  }
  @media (max-width: 600px) {
    .featured-tour-hero { flex-direction: column; }
    .featured-tour-hero figure { flex: none; width: 100%; }
  }
</style>
