---
interface Tour {
  id: string;
  heading: string;
  text: string;
  href: string;
  cta: string;
  image: string;
  imageAlt: string;
}

interface Props {
  h2: string;
  tours: Tour[];
}

const { h2, tours } = Astro.props;
---
<section class="popular-tours" aria-labelledby="popular-tours-heading">
  <div class="kb-row-layout-wrap alignfull has-white-background-color kt-row-has-bg wp-block-kadence-rowlayout">
    <div class="kt-row-column-wrap">
      <div class="wp-block-kadence-column">
        <div class="kt-inside-inner-col">
          <h2 id="popular-tours-heading" class="kt-adv-heading wp-block-kadence-advancedheading">
            {h2}
          </h2>
          <div class="tours-grid">
            {tours.map((tour) => (
              <article class="tour-card">
                <a href={tour.href}>
                  <img
                    loading="lazy"
                    decoding="async"
                    width="337"
                    height="240"
                    src={tour.image}
                    alt={tour.imageAlt}
                  />
                  <h3>{tour.heading}</h3>
                </a>
                <p>{tour.text}</p>
                <a href={tour.href} class="aot-btn-secondary">{tour.cta}</a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Component-specific overrides — structural layout handled in global CSS */
  .popular-tours h2 {
    font-size: 1.6rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: var(--aot-gray-900);
    text-align: center;
    margin: 0 0 2rem;
  }
  .tour-card h3 {
    font-size: 1.1rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: var(--aot-navy-light);
    padding: 0.75rem 1rem 0.25rem;
    margin: 0;
  }
  .tour-card p {
    font-size: 0.9rem;
    color: var(--aot-gray-600);
    padding: 0.25rem 1rem 0.75rem;
    margin: 0;
    line-height: 1.5;
  }
</style>
