---
import Section from "../primitives/Section.astro";

interface InlineLink {
  label: string;
  href: string;
}
interface Props {
  heading?: string;
  text: string;
  details?: string;
  sideCards?: { heading: string; subheading: string; text?: string; image: string; href: string }[];
  cta?: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
  inlineLinks?: InlineLink[];
  packages?: { heading: string; feature: string; subheading?: string; text?: string; image: string; href: string }[];
}

const {
  heading = "Beach Equipment Rentals",
  text,
  details,
  cta = "Check out our rental packages",
  ctaHref = "/rentals/",
  image = "https://activeoahutours.com/wp-content/uploads/2021/06/DSC5297_2000-e1642616607887.jpg",
  imageAlt = "Hiking and Kayaking Tour, epic view",
  inlineLinks = [],
  packages = [],
} = Astro.props;

const renderTextWithLinks = (raw: string, links: InlineLink[]): string => {
  let out = raw;
  for (const link of links) {
    const safeHref = link.href.replace(/"/g, '&quot;');
    const safeLabel = link.label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp(safeLabel, 'g');
    out = out.replace(re, `<a href="${safeHref}">${link.label}</a>`);
  }
  return out;
};
---

<Section
  palette="white"
  region={heading}
  padding="none"
  container={false}
  class="beach-equipment"
>
  <div class="beach-equipment__container">
    <div class="beach-equipment__row">
      <div class="beach-equipment__description">
        <div
          class="beach-equipment__bg"
          style={`background-image:url('${image}')`}
        >
          <img
            src={image}
            alt={imageAlt}
            class="beach-equipment__bg-img"
            width="724"
            height="483"
            loading="lazy"
          />
          <div class="beach-equipment__card">
            <h4 class="beach-equipment__heading">{heading}</h4>
            <p set:html={renderTextWithLinks(text, inlineLinks)} />
            {details && <p>{details}</p>}
            <br />
            <a href={ctaHref}>{cta} <span aria-hidden="true">&#10132;</span></a>
          </div>
        </div>
      </div>
      {packages.length > 0 && (
        <div class="beach-equipment__packages-col">
          <div class="beach-equipment__packages-row">
            {packages.map((pkg) => (
              <a
                href={pkg.href}
                class="beach-equipment__package"
                style={`background-image: url('${pkg.image}')`}
              >
                <h3 class="beach-equipment__package-heading">{pkg.heading}</h3>
                <h3 class="beach-equipment__package-feature">{pkg.feature}</h3>
                {pkg.subheading && (
                  <h4 class="beach-equipment__package-subheading">{pkg.subheading}</h4>
                )}
                {pkg.text && <p class="beach-equipment__package-text">{pkg.text}</p>}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Section>

<style>
  .beach-equipment__container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .beach-equipment__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  .beach-equipment__description {
    flex: 0 0 75%;
    max-width: 75%;
    padding-right: 0;
  }
  .beach-equipment__packages-col {
    flex: 0 0 25%;
    max-width: 25%;
  }
  .beach-equipment__bg {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 320px;
    overflow: hidden;
  }
  .beach-equipment__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .beach-equipment__card {
    position: relative;
    padding: 1.5rem 2rem;
    background: rgba(255, 255, 255, 0.85);
    margin: 2rem auto;
    max-width: 80%;
  }
  .beach-equipment__heading {
    font-family: var(--aot-font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--aot-gray-600);
    margin: 0 0 var(--aot-space-4);
  }
  .beach-equipment__card p {
    font-family: var(--aot-font-body);
    font-size: 0.95rem;
    color: var(--aot-gray-700);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .beach-equipment__card a {
    font-family: var(--aot-font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--aot-blue);
    text-decoration: none;
  }
  .beach-equipment__card a:hover {
    text-decoration: underline;
    color: var(--aot-blue-hover);
  }
  .beach-equipment__packages-row {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .beach-equipment__package {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--aot-space-4);
    min-height: 160px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--aot-white);
    text-decoration: none;
    position: relative;
    transition: filter 0.2s ease;
  }
  .beach-equipment__package::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    transition: background 0.2s ease;
  }
  .beach-equipment__package:hover::before {
    background: rgba(0, 0, 0, 0.6);
  }
  .beach-equipment__package > * {
    position: relative;
    z-index: 1;
  }
  .beach-equipment__package-heading,
  .beach-equipment__package-feature,
  .beach-equipment__package-subheading {
    font-family: var(--aot-font-heading);
    color: var(--aot-white);
    margin: 0.25rem 0;
  }
  .beach-equipment__package-heading {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .beach-equipment__package-feature {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .beach-equipment__package-subheading {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .beach-equipment__package-text {
    font-family: var(--aot-font-body);
    font-size: 0.85rem;
    color: var(--aot-white);
    margin: 0.25rem 0 0;
  }
  @media (max-width: 768px) {
    .beach-equipment__description,
    .beach-equipment__packages-col {
      flex: 0 0 100%;
      max-width: 100%;
    }
    .beach-equipment__packages-col {
      margin-top: var(--aot-space-4);
    }
    .beach-equipment__card {
      max-width: 95%;
      padding: var(--aot-space-4);
    }
    .beach-equipment__heading {
      font-size: 1.2rem;
    }
  }
</style>