---
interface Category {
  heading: string;
  subheading: string;
  text: string;
  image: string;
  imageAlt: string;
}

interface Props {
  h2: string;
  categories: Category[];
}

const { h2, categories } = Astro.props;
---
<section class="rental-types" aria-labelledby="rental-types-heading">
  <div class="kb-row-layout-wrap alignfull has-white-background-color kt-row-has-bg wp-block-kadence-rowlayout">
    <div class="kt-row-column-wrap">
      <div class="wp-block-kadence-column">
        <div class="kt-inside-inner-col">
          <h2 id="rental-types-heading">{h2}</h2>
          <div class="rental-grid">
            {categories.map((cat) => (
              <div class="rental-item">
                <figure>
                  <img
                    loading="lazy"
                    decoding="async"
                    width="115"
                    height="115"
                    src={cat.image}
                    alt={cat.imageAlt}
                  />
                </figure>
                <div class="rental-text">
                  <h3>{cat.heading}</h3>
                  <h4>{cat.subheading}</h4>
                  <p>{cat.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rental-types {
    background: #fff;
    padding: 2rem 0;
  }
  .rental-types h2 {
    font-size: 1.6rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: #333;
    text-align: center;
    margin-bottom: 2rem;
  }
  .rental-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .rental-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    background: #fafafa;
  }
  .rental-item figure {
    flex: 0 0 80px;
    margin: 0;
  }
  .rental-item img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }
  .rental-text h3 {
    font-size: 1.1rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: #003366; /* WCAG AA on #c9c9c9 = 7.2:1 */
    margin: 0 0 0.25rem;
  }
  .rental-text h4 {
    font-size: 0.9rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: #555;
    margin: 0 0 0.5rem;
  }
  .rental-text p {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.85rem;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }
  @media (max-width: 600px) {
    .rental-grid { grid-template-columns: 1fr; }
  }
</style>
