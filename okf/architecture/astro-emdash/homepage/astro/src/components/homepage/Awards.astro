---
interface AwardImage {
  src: string;
  alt: string;
  width?: string;
}

interface Props {
  h2: string;
  awardText: string;
  awardImages: AwardImage[];
}

const { h2, awardText, awardImages } = Astro.props;
---
<section class="awards-section" aria-labelledby="awards-heading">
  <div class="kb-row-layout-wrap alignfull has-white-background-color kt-row-has-bg wp-block-kadence-rowlayout">
    <div class="kt-row-column-wrap">
      <div class="wp-block-kadence-column">
        <div class="kt-inside-inner-col">
          <h2 id="awards-heading">{h2}</h2>
          <p class="awards-text">{awardText}</p>
          <div class="awards-logos">
            {awardImages.map((img) => (
              <img
                loading="lazy"
                decoding="async"
                width={img.width || "200"}
                height="auto"
                src={img.src}
                alt={img.alt}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .awards-section {
    background: #fff;
    padding: 2rem 0;
  }
  .awards-section h2 {
    font-size: 1.6rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: #333;
    text-align: center;
    margin-bottom: 1rem;
  }
  .awards-text {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 1rem;
    color: #555;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .awards-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .awards-logos img {
    max-height: 80px;
    width: auto;
  }
</style>
