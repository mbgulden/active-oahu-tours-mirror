---
interface Props {
  heading?: string;
  text?: string;
  href?: string;
  cta?: string;
  image: string;
  imageAlt?: string;
  packages?: { heading: string; feature: string; subheading?: string; text?: string; image: string; href: string }[];
}

const {
  heading = "Mokoliʻi Island",
  text = "Paddle in an ocean kayak out to the Mokoliʻi (Chinaman's Hat) — Kualoa's iconic offshore island — with a kayak and beach gear rental delivery service.",
  href = "/activities/",
  cta = "Browse tours",
  image = "https://activeoahutours.com/wp-content/uploads/2022/01/Mokolii-from-above-view-1.jpg",
  imageAlt = "Mokoliʻi Island from above",
  packages = [],
} = Astro.props;
---
<section class="mokulua-feature-block" aria-label={heading}>
  <div class="mf-container">
    <div class="mf-row">
      <div class="mf-packages-col">
        <div class="mf-packages-row">
          {packages.map((pkg) => (
            <a href={pkg.href} class="mf-front-page-package darken" style={`background-image: url('${pkg.image}')`}>
              <h3 class="mf-package-front-text">{pkg.heading}</h3>
              <h3 class="mf-feature package-margins">{pkg.feature}</h3>
              {pkg.subheading && <h4 class="mf-package-margins mf-activity-front-text">{pkg.subheading}</h4>}
              {pkg.text && <p class="mf-date-front-text">{pkg.text}</p>}
            </a>
          ))}
        </div>
      </div>
      <section class="mf-description">
        <div class="mf-front-page-with-bg" style={`background-image:url('${image}')`}>
          <img src={image} alt={imageAlt} class="mf-front-page-img-bg" width="724" height="483" loading="lazy" />
          <div class="mf-feature-description-p mf-feature-description-p-left">
            <h4 class="mf-heading">{heading}</h4>
            <p>{text}</p>
            <br />
            <a href={href}>{cta} <span aria-hidden="true">&#10132;</span></a>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .mokulua-feature-block {
    background: #ffffff;
    padding: 0;
  }
  .mf-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .mf-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  .mf-description {
    flex: 0 0 75%;
    max-width: 75%;
    order: 2;
  }
  .mf-packages-col {
    flex: 0 0 25%;
    max-width: 25%;
    order: 1;
  }
  .mf-front-page-with-bg {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 320px;
    overflow: hidden;
  }
  .mf-front-page-img-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mf-feature-description-p-left {
    position: relative;
    padding: 1.5rem 2rem;
    background: rgba(255, 255, 255, 0.85);
    margin: 2rem auto;
    max-width: 80%;
  }
  .mf-heading {
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #586e75;
    margin: 0 0 1rem;
  }
  .mf-feature-description-p p {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .mf-feature-description-p a {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #0066cc;
    text-decoration: none;
  }
  .mf-feature-description-p a:hover {
    text-decoration: underline;
    color: #004999;
  }
  .mf-packages-row {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .mf-front-page-package {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1rem;
    min-height: 160px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #fff;
    text-decoration: none;
    position: relative;
    transition: filter 0.2s ease;
  }
  .mf-front-page-package.darken::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    transition: background 0.2s ease;
  }
  .mf-front-page-package.darken:hover::before {
    background: rgba(0, 0, 0, 0.6);
  }
  .mf-front-page-package > * {
    position: relative;
    z-index: 1;
  }
  .mf-package-front-text {
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .mf-feature.package-margins {
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0.25rem 0;
  }
  .mf-package-margins.mf-activity-front-text {
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin: 0.25rem 0;
  }
  .mf-date-front-text {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.85rem;
    color: #fff;
    margin: 0.25rem 0 0;
  }
  @media (max-width: 768px) {
    .mf-description,
    .mf-packages-col {
      flex: 0 0 100%;
      max-width: 100%;
      order: 0;
    }
    .mf-feature-description-p-left {
      max-width: 95%;
      padding: 1rem;
    }
    .mf-heading {
      font-size: 1.2rem;
    }
  }
</style>
