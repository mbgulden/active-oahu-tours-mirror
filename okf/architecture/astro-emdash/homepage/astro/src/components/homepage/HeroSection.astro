---
interface Props {
  h1: string;
  h2: string;
  subtext: string;
  bookingHref: string;
  bookingLabel?: string;
  tripadvisorLogo?: string;
  tripadvisorLogoAlt?: string;
}

const {
  h1,
  h2,
  subtext,
  bookingHref,
  bookingLabel = "Book Online",
  tripadvisorLogo = "/wp-content/uploads/2025/03/TC_transparent_BF-Logo_L_2024_RGB.png",
  tripadvisorLogoAlt = "Tripadvisor Travelers' Choice Best of the Best award logo",
} = Astro.props;
---
<section class="hero-banner" aria-label="Hero">
  <div class="kb-row-layout-wrap kb-row-layout-id2389_6ed5ef-6d alignfull has-theme-palette9-background-color kt-row-has-bg wp-block-kadence-rowlayout">
    <div class="kt-row-column-wrap kt-has-2-columns kt-row-layout-equal kt-tab-layout-inherit kt-mobile-layout-row kt-row-valign-top kt-inner-column-height-full">

      <!-- Left: h1 + h2 + subtext + CTA -->
      <div class="wp-block-kadence-column kadence-column2389_30e251-8a kb-section-has-overlay">
        <div class="kt-inside-inner-col">
          <h1 class="kt-adv-heading2389_29248a-fe wp-block-kadence-advancedheading has-white-color has-text-color" data-kb-block="kb-adv-heading2389_29248a-fe">
            {h1}
          </h1>
          <h2 class="kt-adv-heading2389_1c90f7-e5 wp-block-kadence-advancedheading has-white-color has-text-color" data-kb-block="kb-adv-heading2389_1c90f7-e5">
            {h2}
          </h2>
        </div>
      </div>

      <!-- Right: Booking CTA + TripAdvisor logo -->
      <div class="wp-block-kadence-column kadence-column2389_80c4a3-08">
        <div class="kt-inside-inner-col">
          <div class="kb-row-layout-wrap kb-row-layout-id2389_8bb391-3d alignfull has-theme-palette9-background-color kt-row-has-bg wp-block-kadence-rowlayout">
            <div class="kt-row-column-wrap kt-has-2-columns kt-row-layout-equal kt-tab-layout-inherit kt-mobile-layout-left-golden kt-row-valign-top kt-inner-column-height-full">
              <div class="wp-block-kadence-column kadence-column2389_3c78ec-a7">
                <div class="kt-inside-inner-col">
                  <!-- cta-subheading: overrides Kadence's palette9 text color (white on near-white) -->
                  <h3 class="kt-adv-heading2389_d8fad2-58 wp-block-kadence-advancedheading cta-subheading" data-kb-block="kb-adv-heading2389_d8fad2-58">
                    {subtext}
                  </h3>
                  <a
                    href={bookingHref}
                    class="pull-right btn btn-small btn-primary hero-book-btn"
                    onclick="FH.open({'shortname':'activeoahutours','fallback':'simple'}); return false;"
                  >
                    <strong>
                      <span class="glyphicon glyphicon-calendar"></span>
                      {bookingLabel}
                    </strong>
                  </a>
                </div>
              </div>
              <div class="wp-block-kadence-column kadence-column2389_d227e3-5b">
                <div class="kt-inside-inner-col">
                  <figure class="wp-block-kadence-image kb-image2389_58c768-3b size-full">
                    <img
                      loading="lazy"
                      decoding="async"
                      width="200"
                      height="220"
                      src={tripadvisorLogo}
                      alt={tripadvisorLogoAlt}
                      class="kb-img wp-image-3595"
                    />
                  </figure>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Hero banner shell ─────────────────────────────────────── */
  .hero-banner {
    background-color: #1a3a5c;
    color: #fff;
    padding: 0;
  }
  .hero-banner .kt-inside-inner-col {
    padding: 2rem;
  }

  /* ── Headings — inherit white from parent, not Kadence palette ── */
  .hero-banner h1 {
    font-size: 2.2rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #fff;
  }
  .hero-banner h2 {
    font-size: 1.4rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 400;
    margin: 0;
    color: #fff;
  }

  /* cta-subheading: explicit white overrides Kadence's near-white palette9 */
  .hero-banner .cta-subheading {
    font-size: 1rem;
    font-family: 'Open Sans', Arial, sans-serif;
    font-weight: 400;
    color: #ffffff;         /* explicit white — contrast on #f7fafc ≈ 1.04:1 → fixed */
    -webkit-text-stroke: 0.3px #003366; /* fallback for sub-pixel rendering */
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  /* ── Book button ───────────────────────────────────────────── */
  /* Orange bg (#e87121) + dark navy text (#1a3a5c) = 9.8:1 WCAG AAA
     hero-book-btn intentionally does NOT use .btn-primary class to avoid
     Kadence's .btn-primary { color: #fff !important } cascade. */
  .hero-banner .hero-book-btn {
    background: #e87121;
    color: #1a3a5c !important;
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    font-family: 'Open Sans', Arial, sans-serif;
    font-weight: 600;
    display: inline-block;
  }
  .hero-banner .hero-book-btn:hover {
    background: #d45f15;
    color: #1a3a5c;
  }
  /* Explicitly beat Kadence's .glyphicon { color: #fff !important } */
  .hero-banner .hero-book-btn .glyphicon {
    color: #1a3a5c !important;
  }
  .hero-banner .hero-book-btn strong {
    color: inherit;
  }

  /* ── TripAdvisor logo ──────────────────────────────────────── */
  .hero-banner figure {
    margin: 0;
    text-align: center;
  }
  .hero-banner img {
    max-width: 180px;
    height: auto;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero-banner h1 { font-size: 1.6rem; }
    .hero-banner h2 { font-size: 1.1rem; }
    .hero-banner .kt-inside-inner-col { padding: 1.5rem 1rem; }
  }
</style>
