---
// 3-column footer area matching production: Follow Adventures | Newsletter | Awesome Photos gallery
// Gallery uses 5 unique images. Production uses:
//   - DSC5447_2000-115x115
//   - Oahu-Kayaking-Tours_31-2-115x115  (also in RentalGrid)
//   - Oahu-Kayaking-Tours_13-115x115    (also in RentalGrid)
//   - Oahu-Kayak-Tours_11_thumb-1-115x115 (also in RentalGrid)
//   - Oahu-Snorkeling_6-1-115x115      (also in RentalGrid)
// Production has these dupes, but since we want zero dupes, we use the 5 *additional* gallery
// thumbnails that are NOT in any other section.
interface Props {
  phone?: string;
  email?: string;
  address?: string;
  socialLinks?: { label: string; href: string }[];
  formAction?: string;
  formId?: string;
  galleryImages?: { src: string; alt: string; href?: string }[];
  headingFollow?: string;
  headingNewsletter?: string;
  headingGallery?: string;
}

const {
  phone = "(808)498-1894",
  email = "info@activeoahutours.com",
  address = "134B Hamakua Dr., Kailua, HI, 96734",
  socialLinks = [
    { label: "Facebook", href: "https://www.facebook.com/activeoahutours/" },
    { label: "Yelp", href: "https://www.yelp.com/biz/active-oahu-tours-kailua" },
    { label: "Tripadvisor", href: "https://www.tripadvisor.com/Attraction_Review-g60656-d5079465-Reviews-Active_Oahu_Tours-Laie_Oahu_Hawaii.html" },
    { label: "Instagram", href: "https://www.instagram.com/activeoahu/" },
  ],
  formAction = "https://activeoahu.us9.list-manage.com/subscribe/post?u=5cb586c27776f84f261f708d6&id=894ddfa45f",
  formId = "mc-embedded-subscribe-form",
  // 5 unique images that DON'T overlap with RentalGrid, Mokulua FeaturedTourHero, or FeaturedTours
  galleryImages = [
    { src: "/wp-content/uploads/2018/11/DSC5447_2000-115x115.jpg", alt: "Oahu Beach Equipment Rental Packages", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2018/11/DSC5297_2000-115x115.jpg", alt: "Hiking and Kayaking Tour", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2018/11/DJI_0988_2000_1x2-115x115.jpg", alt: "Oahu Kayak Adventure", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2016/11/Standup-Paddleboard-Lessons_Thumbnail-1-115x115.jpg", alt: "Standup Paddleboard Lessons on Oahu", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2023/03/lanikai-Kayak-rental-480x320.jpg", alt: "Lanikai Kayak Rental", href: "/active-oahu-photo-gallery/" },
  ],
  headingFollow = "Follow our Oʻahu Adventures",
  headingNewsletter = "Get Updates and Freebies",
  headingGallery = "Awesome Photos",
} = Astro.props;
---
<section class="footer-extras" aria-label="Footer extras">
  <div class="footer-extras-container">
    <div class="footer-col footer-col-follow">
      <h3>{headingFollow}</h3>
      <p>Keep up-to-date with our social media, or just contact us directly</p>
      <h4><a href={`tel:${phone.replace(/[^\d+]/g, "")}`}>{phone}</a></h4>
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <p><address>{address}</address></p>
      <div class="footer-social-links">
        {socialLinks.map((link) => (
          <a target="_blank" rel="noopener" href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>

    <div class="footer-col footer-col-newsletter">
      <h3>{headingNewsletter}</h3>
      <p class="small">Sign up for our email newsletter for exclusive deals &amp; freebies</p>
      <form action={formAction} method="post" id={formId} name="mc-embedded-subscribe-form" class="validate footer-newsletter-form" target="_blank" novalidate>
        <div class="footer-newsletter-row">
          <input type="email" value="" placeholder="Email" name="EMAIL" class="required email footer-newsletter-email" id="mce-EMAIL" aria-label="Email address" required />
          <button type="submit" name="subscribe" class="footer-newsletter-submit">Subscribe</button>
        </div>
      </form>
    </div>

    <div class="footer-col footer-col-gallery">
      <h3>{headingGallery}</h3>
      <p>We've got plenty of photos to show off our kayaking, snorkeling, hiking and SUP adventures. We also love the scenery and showing off our gear.</p>
      <div class="footer-gallery-grid">
        {galleryImages.map((img) => (
          <a href={img.href || "/active-oahu-photo-gallery/"} aria-label="View Active Oahu photo gallery">
            <img src={img.src} alt={img.alt} width="115" height="115" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .footer-extras {
    background: #fff;
    padding: 2.5rem 1rem;
    border-top: 1px solid #e0e0e0;
  }
  .footer-extras-container {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
  }
  .footer-col h3 {
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #333;
    margin: 0 0 0.75rem;
  }
  .footer-col p {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.9rem;
    color: #555;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }
  .footer-col p.small {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .footer-col h4 {
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0.5rem 0;
  }
  .footer-col a {
    color: #0066cc;
    text-decoration: none;
  }
  .footer-col a:hover {
    text-decoration: underline;
  }
  .footer-social-links {
    margin-top: 0.75rem;
  }
  .footer-social-links a {
    display: inline-block;
    margin-right: 0.5rem;
    margin-bottom: 0.25rem;
    font-size: 0.85rem;
  }
  .footer-newsletter-form {
    margin-top: 0.5rem;
  }
  .footer-newsletter-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .footer-newsletter-email {
    flex: 1;
    min-width: 180px;
    padding: 0.5rem 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 0.9rem;
    font-family: 'Open Sans', Arial, sans-serif;
  }
  .footer-newsletter-submit {
    padding: 0.5rem 1rem;
    background: #006699;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .footer-newsletter-submit:hover {
    background: #005580;
  }
  .footer-gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
    margin-top: 0.75rem;
  }
  .footer-gallery-grid a {
    display: block;
    overflow: hidden;
    border-radius: 4px;
    transition: transform 0.2s ease;
  }
  .footer-gallery-grid a:hover {
    transform: scale(1.04);
  }
  .footer-gallery-grid img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 768px) {
    .footer-extras-container {
      grid-template-columns: 1fr;
    }
    .footer-gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
