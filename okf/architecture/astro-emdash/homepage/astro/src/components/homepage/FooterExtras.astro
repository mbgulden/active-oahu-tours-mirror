---
import Section from "../primitives/Section.astro";

// 3-column footer area matching production: Follow Adventures | Newsletter | Awesome Photos gallery
// Gallery uses 5 unique images. Production uses:
//   - DSC5447_2000-115x115
//   - Oahu-Kayaking-Tours_31-2-115x115  (also in RentalGrid)
//   - Oahu-Kayaking-Tours_13-115x115    (also in RentalGrid)
//   - Oahu-Kayak-Tours_11_thumb-1-115x115 (also in RentalGrid)
//   - Oahu-Snorkeling_6-1-115x115      (also in RentalGrid)
// Production has these dupes, but since we want zero dupes, we use the 5 *additional* gallery
// thumbnails that are NOT in any other section.
interface Props {
  phone?: string;
  email?: string;
  address?: string;
  socialLinks?: { label: string; href: string }[];
  formAction?: string;
  formId?: string;
  galleryImages?: { src: string; alt: string; href?: string }[];
  headingFollow?: string;
  headingNewsletter?: string;
  headingGallery?: string;
}

const {
  phone = "(808)498-1894",
  email = "info@activeoahutours.com",
  address = "134B Hamakua Dr., Kailua, HI, 96734",
  socialLinks = [
    { label: "Facebook", href: "https://www.facebook.com/activeoahutours/" },
    { label: "Yelp", href: "https://www.yelp.com/biz/active-oahu-tours-kailua" },
    { label: "Tripadvisor", href: "https://www.tripadvisor.com/Attraction_Review-g60656-d5079465-Reviews-Active_Oahu_Tours-Laie_Oahu_Hawaii.html" },
    { label: "Instagram", href: "https://www.instagram.com/activeoahu/" },
  ],
  formAction = "https://activeoahu.us9.list-manage.com/subscribe/post?u=5cb586c27776f84f261f708d6&id=894ddfa45f",
  formId = "mc-embedded-subscribe-form",
  // 8 images matching production's "Awesome Photos" footer gallery exactly
  galleryImages = [
    { src: "/wp-content/uploads/2018/11/DSC5447_2000-115x115.jpg", alt: "Oahu Beach Equipment Rental Packages", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2016/11/Oahu-Kayaking-Tours_31-2-115x115.jpg", alt: "Kayaking to Mokolii", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2016/11/Oahu-Kayaking-Tours_13-115x115.jpg", alt: "Hiking Mokoli'i on Oahu", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2016/11/Oahu-Kayak-Tours_11_thumb-1-115x115.jpg", alt: "Best Oahu Kayak Tour", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2016/11/Oahu-Snorkeling_6-1-115x115.jpg", alt: "Oahu Snorkel Tours", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2016/11/Standup-Paddleboard-Lessons_Thumbnail-1-115x115.jpg", alt: "Stand up paddle boarding in Oahu", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2018/11/DJI_0988_2000_1x2-115x115.jpg", alt: "Aerial Active Oahu photo gallery thumbnail", href: "/active-oahu-photo-gallery/" },
    { src: "/wp-content/uploads/2018/11/DSC5297_2000-115x115.jpg", alt: "Oahu malibu kayaks pro 2 tandem ocean Kayak Rentals", href: "/active-oahu-photo-gallery/" },
  ],
  headingFollow = "Follow our Oʻahu Adventures",
  headingNewsletter = "Get Email Updates",
  headingGallery = "Awesome Photos",
} = Astro.props;
---

<Section
  palette="white"
  region="Footer extras"
  padding="md"
  container={false}
  class="footer-extras"
>
  <div class="footer-extras__container">
    <div class="footer-extras__col footer-extras__col-follow">
      <h3 class="footer-extras__h3">{headingFollow}</h3>
      <p>Keep up-to-date with our social media, or just contact us directly</p>
      <h4><a href={`tel:${phone.replace(/[^\d+]/g, "")}`}>{phone}</a></h4>
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <p><address>{address}</address></p>
      <div class="footer-extras__social-links">
        {socialLinks.map((link) => (
          <a target="_blank" rel="noopener" href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>

    <div class="footer-extras__col footer-extras__col-newsletter">
      <h3 class="footer-extras__h3">{headingNewsletter}</h3>
      <p class="footer-extras__small">Sign up for our email newsletter for exclusive deals &amp; freebies</p>
      <form action={formAction} method="post" id={formId} name="mc-embedded-subscribe-form" class="validate footer-extras__form" target="_blank" novalidate>
        <div class="footer-extras__newsletter-row">
          <input type="email" value="" placeholder="Email" name="EMAIL" class="required email footer-extras__email" id="mce-EMAIL" aria-label="Email address" required />
          <button type="submit" name="subscribe" class="footer-extras__submit">Subscribe</button>
        </div>
      </form>
    </div>

    <div class="footer-extras__col footer-extras__col-gallery">
      <h3 class="footer-extras__h3">{headingGallery}</h3>
      <p>We've got plenty of photos to show off our kayaking, snorkeling, hiking and SUP adventures. We also love the scenery and showing off our gear.</p>
      <div class="footer-extras__gallery-grid">
        {galleryImages.map((img) => (
          <a href={img.href || "/active-oahu-photo-gallery/"} data-lightbox="aot-gallery" data-title={img.alt} aria-label={`View larger image: ${img.alt}`}>
            <img src={img.src} alt={img.alt} width="115" height="115" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
      <a href="/active-oahu-photo-gallery/" class="footer-extras__gallery-link">
        <strong>View the Gallery</strong> <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Section>
<style>
  .footer-extras {
    border-top: 1px solid var(--aot-gray-200);
  }
  .footer-extras__container {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
  }
  .footer-extras__h3 {
    font-family: var(--aot-font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--aot-gray-800);
    margin: 0 0 var(--aot-space-3);
  }
  .footer-extras__col p {
    font-family: var(--aot-font-body);
    font-size: 0.9rem;
    color: var(--aot-gray-700);
    line-height: 1.5;
    margin: 0 0 var(--aot-space-2);
  }
  .footer-extras__col p.footer-extras__small {
    font-size: 0.85rem;
    margin-bottom: var(--aot-space-3);
  }
  .footer-extras__col h4 {
    font-family: var(--aot-font-body);
    font-size: 1rem;
    font-weight: 700;
    margin: var(--aot-space-2) 0;
  }
  .footer-extras__col a {
    color: var(--aot-blue);
    text-decoration: none;
  }
  .footer-extras__col a:hover {
    text-decoration: underline;
  }
  .footer-extras__social-links {
    margin-top: var(--aot-space-3);
  }
  .footer-extras__social-links a {
    display: inline-block;
    margin-right: var(--aot-space-2);
    margin-bottom: var(--aot-space-1);
    font-size: 0.85rem;
  }
  .footer-extras__form {
    margin-top: var(--aot-space-2);
  }
  .footer-extras__newsletter-row {
    display: flex;
    gap: var(--aot-space-2);
    flex-wrap: wrap;
  }
  .footer-extras__email {
    flex: 1;
    min-width: 180px;
    padding: var(--aot-space-2) var(--aot-space-3);
    border: 1px solid #ccc;
    border-radius: var(--aot-border-radius);
    font-size: 0.9rem;
    font-family: var(--aot-font-body);
  }
  .footer-extras__submit {
    padding: var(--aot-space-2) var(--aot-space-4);
    background: var(--aot-blue);
    color: var(--aot-white);
    border: none;
    border-radius: var(--aot-border-radius);
    font-family: var(--aot-font-body);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .footer-extras__submit:hover {
    background: var(--aot-blue-hover);
  }
  .footer-extras__gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    margin-top: var(--aot-space-3);
  }
  .footer-extras__gallery-grid a {
    display: block;
    overflow: hidden;
    border-radius: 5px;
    transition: transform 0.2s ease;
  }
  .footer-extras__gallery-grid a:hover {
    transform: scale(1.04);
  }
  .footer-extras__gallery-grid img {
    width: 100%;
    height: 115px;
    object-fit: cover;
    display: block;
  }
  .footer-extras__gallery-link {
    display: inline-block;
    margin-top: var(--aot-space-3);
    color: var(--aot-blue);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .footer-extras__gallery-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .footer-extras__container {
      grid-template-columns: 1fr;
    }
    .footer-extras__gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
