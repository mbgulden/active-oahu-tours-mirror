---
import Section from "../primitives/Section.astro";
import Heading from "../primitives/Heading.astro";

interface RentalCta {
  text: string;
  href: string;
}

interface Feature {
  id: string;
  icon: string;
  iconAlt: string;
  heading: string;
  text: string;
  href?: string;
}

interface Props {
  h2: string;
  intro?: string;
  features: Feature[];
  rentalCta?: RentalCta;
  moreRentalCta?: RentalCta;
}

const { h2, intro, features, rentalCta, moreRentalCta } = Astro.props;
---

<Section
  palette="white"
  region="Features"
  padding="lg"
  container={false}
  class="feature-block"
>
  <div class="feature-block__grid">
    <div class="feature-block__intro-col">
      <div class="feature-block__inner">
        <Heading id="feature-block-heading" level={2} size="lg" color="body" align="center">
          {h2}
        </Heading>
        {intro && <p class="feature-block-intro" set:html={intro} />}
        {rentalCta && (
          <p class="feature-block__cta-row">
            <a href={rentalCta.href} class="feature-cta">
              <strong>{rentalCta.text}</strong>
            </a>
          </p>
        )}
        {moreRentalCta && (
          <p class="feature-block__cta-row">
            <a href={moreRentalCta.href} class="feature-cta-secondary">
              {moreRentalCta.text} &#10132;
            </a>
          </p>
        )}
      </div>
    </div>
    {features.map((feature) => (
      <div class="feature-block__card-col">
        <div class="feature-block__inner">
          <a class="feature-block__card-link" href={feature.href || '/activities/'} data-instant>
            <figure class="feature-block__figure">
              <img
                loading="lazy"
                decoding="async"
                width="200"
                height="115"
                src={feature.icon}
                alt={feature.iconAlt}
                class="feature-block__icon"
              />
            </figure>
            <Heading level={3} size="md" color="blue" align="center" class="feature-heading">
              {feature.heading}
            </Heading>
          </a>
          {feature.id === 'ebike' ? (
            <p class="feature-block__desc">
              We take day-of and last minute tour or rental bookings.<br />
              <a href="tel:+1-808-498-1894" class="feature-block__phone">Call us at: (808)498-1894</a>
              or visit our shop at 134B Hamakua Dr. Kailua HI 96734
            </p>
          ) : (
            <p class="feature-block__desc">{feature.text}</p>
          )}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  .feature-block__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: var(--aot-space-4);
    align-items: stretch;
  }
  .feature-block__intro-col,
  .feature-block__card-col {
    min-width: 0;
  }
  .feature-block__inner {
    padding: var(--aot-space-5);
    text-align: center;
    height: 100%;
  }
  .feature-block-intro {
    margin: 0 0 var(--aot-space-4);
  }
  .feature-block__cta-row {
    margin: 0;
  }
  .feature-block__figure {
    margin: 0 auto var(--aot-space-3);
  }
  .feature-block__icon {
    width: 200px;
    height: 115px;
    object-fit: contain;
  }
  .feature-block__desc {
    font-family: var(--aot-font-body);
    color: var(--aot-gray-700);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .feature-block__phone {
    color: var(--aot-blue);
    font-weight: 600;
  }
  .feature-block__card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  @media (max-width: 768px) {
    .feature-block__grid {
      grid-template-columns: 1fr;
    }
  }
</style>