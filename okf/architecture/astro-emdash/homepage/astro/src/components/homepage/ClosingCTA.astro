---
interface Props {
  h2: string;
  text: string;
  phone: string;
  phoneHref: string;
}

const { h2, text, phone, phoneHref } = Astro.props;
---
<section class="closing-cta" aria-labelledby="closing-cta-heading">
  <div class="kb-row-layout-wrap alignfull has-theme-palette9-background-color kt-row-has-bg wp-block-kadence-rowlayout closing-cta-bg">
    <div class="kt-row-column-wrap">
      <div class="wp-block-kadence-column">
        <div class="kt-inside-inner-col">
          <h2 id="closing-cta-heading">{h2}</h2>
          <p>{text}</p>
          <a href={phoneHref} class="aot-btn-phone">
            <span class="glyphicon glyphicon-earphone" aria-hidden="true"></span>
            {phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Closing CTA shell ─────────────────────────────────────── */
  .closing-cta {
    color: var(--aot-white);
    padding: 2rem 0;
    text-align: center;
  }
  .closing-cta h2 {
    font-size: 1.6rem;
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-weight: 700;
    color: var(--aot-white);
    margin: 0 0 1rem;
  }
  .closing-cta p {
    font-size: 1rem;
    color: var(--aot-text-light);
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }
</style>
