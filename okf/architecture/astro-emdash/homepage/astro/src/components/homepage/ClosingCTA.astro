---
import Section from "../primitives/Section.astro";

interface Props {
  h2: string;
  text: string;
  phone: string;
  phoneHref: string;
}

const { h2, text, phone, phoneHref } = Astro.props;
---

<Section
  palette="none"
  region="Booking CTA"
  padding="lg"
  container={true}
  class="closing-cta"
>
  <h2 id="closing-cta-heading" class="closing-cta__heading">{h2}</h2>
  <p class="closing-cta__text">{text}</p>
  <a href={phoneHref} class="aot-btn-phone closing-cta__phone-btn">
    <span aria-hidden="true">&#9742;</span>
    {phone}
  </a>
</Section>

<style>
  .closing-cta {
    background-color: var(--aot-hero-bg);
    color: var(--aot-white);
    text-align: center;
  }
  .closing-cta__heading {
    font-family: var(--aot-font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--aot-white);
    margin: 0 0 var(--aot-space-4);
  }
  .closing-cta__text {
    font-size: 1rem;
    color: var(--aot-text-light);
    margin: 0 0 var(--aot-space-5);
    line-height: 1.6;
  }
  .closing-cta__phone-btn {
    color: var(--aot-white);
    text-decoration: none;
  }
</style>