---
import shellData from "../../content/nav/aot-shell-data.json";
const { business, footerGroups } = shellData;

const year = new Date().getFullYear();
---

<footer role="contentinfo" class="aot-site-footer">
  <!-- Contact block: business name + phone + email (matches production's 1st footer column) -->
  <div class="footer-contact">
    <p class="footer-business-name">
      <strong>{business.name}</strong>
    </p>
    <address class="footer-address">
      <a href={`tel:+1-${business.phoneRaw}`}>{business.phone}</a>
      &nbsp;·&nbsp;
      <a href={`mailto:${business.email}`}>{business.email}</a>
    </address>
  </div>

  <!-- Nav groups: matches production's footer-links structure (About / Cancellation / Privacy) -->
  <nav class="footer-nav" aria-label="Footer navigation">
    {footerGroups.map((group) => (
      <div class="footer-nav-group">
        <h2 class="footer-nav-heading">{group.heading}</h2>
        <ul class="footer-nav-list" role="list">
          {group.items.map((item) => (
            <li>
              <a href={item.href} class="footer-nav-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Legal row: matches production's footer-links breadcrumb pattern -->
  <div class="footer-legal">
    <p class="footer-copyright">
      &copy; {year} {business.name}. All rights reserved.
    </p>
    <ul class="footer-legal-links" role="list">
      <li><a href="/privacy-policy/">Privacy Policy</a></li>
      <li><a href="/cancellation-policy/">Cancellation Policy</a></li>
    </ul>
  </div>
</footer>

<style>
  .aot-site-footer {
    background: #f8f9fa;
    color: #333;
    padding: 2.5rem 1rem 1.5rem;
    font-family: 'Open Sans', Arial, sans-serif;
    border-top: 1px solid #e0e0e0;
  }

  .footer-contact {
    max-width: 1140px;
    margin: 0 auto 1.5rem;
    text-align: center;
  }

  .footer-business-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #003366;
    margin: 0 0 0.25rem;
  }

  .footer-address {
    font-style: normal;
    color: #555;
    font-size: 0.95rem;
    margin: 0;
  }

  .footer-address a {
    color: #0066cc;
    text-decoration: none;
  }

  .footer-address a:hover {
    text-decoration: underline;
  }

  .footer-nav {
    max-width: 1140px;
    margin: 0 auto 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .footer-nav-heading {
    font-family: 'Open Sans Condensed', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #003366;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-nav-list li {
    margin: 0 0 0.25rem;
  }

  .footer-nav-link {
    color: #555;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .footer-nav-link:hover {
    color: #0066cc;
    text-decoration: underline;
  }

  .footer-legal {
    max-width: 1140px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid #e0e0e0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copyright {
    color: #666;
    font-size: 0.85rem;
    margin: 0;
  }

  .footer-legal-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal-links a {
    color: #666;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .footer-legal-links a:hover {
    color: #0066cc;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
    .footer-legal {
      flex-direction: column;
      text-align: center;
    }
  }
</style>