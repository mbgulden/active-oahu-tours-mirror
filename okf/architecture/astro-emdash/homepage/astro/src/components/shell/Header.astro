---
import shellData from "../../content/nav/aot-shell-data.json";
import BookNowButton from "./BookNowButton.astro";
import PrimaryNav from "./PrimaryNav.astro";
const business = shellData.business;
const languageLinks = shellData.utilityLinks.filter((link) => link.intent === "language");
---
<header class="clearfix" role="banner">
  <section id="branding">
    <div class="aot-logo">
      <a href="/" rel="home" aria-label="Active Oahu Tours, Oahu Hawaii Activities">
        <img loading="eager" decoding="async" alt="Active Oahu Tours, Oahu Hawaii Activities" src="/wp-content/uploads/2019/06/Active-Oahu-Logo.jpg" width="232" height="65" />
      </a>
    </div>
    <div class="social-header">
      <h3 class="social-header-h3">
        <span class="sr-only">Call or Text </span>
        <a href={business.telephoneHref}>{business.phone}</a>
      </h3>
      <div class="social-links">
        <BookNowButton />
        <span class="lang-switcher">{languageLinks.map((link) => <a href={link.href}>{link.label}</a>)}</span>
      </div>
    </div>
  </section>
  <PrimaryNav bookingHref={business.bookingUrl} bookingLabel="Book Now" phoneHref={business.telephoneHref} />
</header>

<!-- Breadcrumb strip (matches production) -->
<div class="breadcrumb-container" aria-label="Breadcrumb">
  <div class="breadcrumb-inner">
    <p id="breadcrumbs"><span class="breadcrumb-current">Home</span></p>
  </div>
</div>

<style>
  /* ── Branding row (logo + phone + book button) ───────────── */
  #branding {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 0 0.75rem;
    min-height: 88px;
  }

  /* Logo size cap (production: 186×52) */
  .aot-logo img {
    max-width: 186px;
    height: auto;
    display: block;
  }

  /* Social-header (phone + book btn + lang) */
  .social-header {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    text-align: right;
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang-switcher {
    font-size: 0.85rem;
  }
  .lang-switcher a {
    color: #006699;
    text-decoration: none;
  }
  .lang-switcher a:hover {
    text-decoration: underline;
  }

  /* Phone: burnt orange #9B4500, 18px (matches production) */
  .social-header-h3 {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-family: 'Open Sans Condensed', Arial Narrow, Arial, sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }
  .social-header-h3 a {
    color: #9B4500;
    text-decoration: none;
  }
  .social-header-h3 a:hover {
    text-decoration: underline;
  }

  /* Screen-reader-only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* Breadcrumb */
  .breadcrumb-container {
    background: #fafafa;
    border-bottom: 1px solid #eee;
    padding: 8px 12px;
    font-family: 'Open Sans', Arial, sans-serif;
  }
  .breadcrumb-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .breadcrumb-container p {
    margin: 0;
    font-size: 0.8rem;
    color: #666;
  }
  .breadcrumb-current {
    color: #333;
  }

  /* Mobile tweaks */
  @media (max-width: 767px) {
    #branding {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem 0;
    }
    .social-header {
      align-items: flex-start;
      text-align: left;
    }
    .social-header-h3 { font-size: 14px; }
  }
</style>
