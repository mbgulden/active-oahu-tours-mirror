---
import shellData from "../../content/nav/aot-shell-data.json";
import BookNowButton from "./BookNowButton.astro";
import PrimaryNav from "./PrimaryNav.astro";
const business = shellData.business;
const languageLinks = shellData.utilityLinks.filter((link) => link.intent === "language");
---
<header class="clearfix" role="banner">
  <section id="branding">
    <div class="aot-logo">
      <a href="/" rel="home" aria-label="Active Oahu Tours, Oahu Hawaii Activities">
        <img loading="eager" decoding="async" alt="Active Oahu Tours, Oahu Hawaii Activities" src="/wp-content/uploads/2019/06/Active-Oahu-Logo.jpg" width="232" height="65" />
      </a>
    </div>
    <div class="social-header">
      <h3 class="social-header-h3">
        <span class="social-header-label">Phone:</span>
        <a href={business.telephoneHref}>{business.phone}</a>
      </h3>
      <div class="social-links">
        <BookNowButton />
        <span class="lang-switcher">{languageLinks.map((link) => <a href={link.href}>{link.label}</a>)}</span>
      </div>
    </div>
  </section>
  <PrimaryNav bookingHref={business.bookingUrl} bookingLabel="Book Now" phoneHref={business.telephoneHref} />
</header>

<style>
  .social-header-h3 {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-family: 'Open Sans', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 600;
  }
  .social-header-label {
    color: #006699;
    font-weight: 700;
  }
  .social-header-h3 a {
    color: #006699;
    text-decoration: none;
  }
  .social-header-h3 a:hover {
    text-decoration: underline;
  }
</style>
