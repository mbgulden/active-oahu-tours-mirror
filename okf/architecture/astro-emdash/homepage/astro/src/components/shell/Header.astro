---
import shellData from "../../content/nav/aot-shell-data.json";
import BookNowButton from "./BookNowButton.astro";
import PrimaryNav from "./PrimaryNav.astro";
const business = shellData.business;
const languageLinks = shellData.utilityLinks.filter((link) => link.intent === "language");
---
<header class="clearfix" role="banner">
  <section id="branding">
    <div class="aot-logo">
      <a href="/" rel="home" aria-label="Active Oahu Tours, Oahu Hawaii Activities">
        <img loading="lazy" decoding="async" alt="Active Oahu Tours, Oahu Hawaii Activities" src="/wp-content/uploads/2019/06/Active-Oahu-Logo.jpg" width="232" height="65" />
      </a>
    </div>
    <div class="social-header">
      <h3 class="social-header-h3">
        <span class="feature">{business.phone}</span>
      </h3>
      <div class="social-links">
        <BookNowButton />
        <span class="lang-switcher">{languageLinks.map((link) => <a href={link.href}>{link.label}</a>)}</span>
      </div>
    </div>
  </section>
  <PrimaryNav bookingHref={business.bookingUrl} bookingLabel="Book Now" phoneHref={business.telephoneHref} />
</header>

<style>
  /* ── Branding row (matches production's nav-fix.css) ─────── */
  #branding {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1140px;
    margin: 0 auto;
    padding: 10px 24px;
  }

  #branding .aot-logo {
    float: none;
    margin: 0;
    max-width: none;
    width: auto;
  }

  /* Logo (production: max-height: 52px) */
  .aot-logo img {
    max-height: 52px;
    width: auto;
    max-width: none;
    display: block;
  }

  /* Social-header (production: column, right-aligned) */
  .social-header {
    float: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    margin-left: auto;
    width: auto;
  }

  /* "Call or Text" via ::before pseudo-element (production pattern) */
  .social-header-h3 {
    font-size: 18px;
    font-family: 'Open Sans Condensed', Arial Narrow, Arial, sans-serif;
    margin: 0;
    text-align: right;
    line-height: 1.2;
  }
  .social-header-h3::before {
    content: "Call or Text";
    font-size: 9px;
    display: block;
    text-align: right;
    color: #888;
    font-weight: 400;
    font-family: 'Open Sans', Arial, sans-serif;
    text-transform: none;
    letter-spacing: normal;
  }

  /* Phone: orange #ff7f00 (production) */
  .social-header .feature,
  .social-header-h3 .feature {
    color: #ff7f00;
    text-decoration: none;
    font-weight: 700;
  }
  .social-header-h3 .feature:hover {
    text-decoration: underline;
  }

  /* Book button container */
  .social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Language switcher (production has it!) */
  .lang-switcher {
    font-size: 13px;
    margin: 0;
    display: inline-block;
    vertical-align: baseline;
    line-height: 1.4;
  }
  .lang-switcher a {
    color: #006699;
    text-decoration: none;
    padding: 0 6px;
    display: inline;
  }
  .lang-switcher a:hover {
    text-decoration: underline;
  }

  /* Mobile tweaks (production: phone + btn + lang in a single row) */
  @media (max-width: 767px) {
    .social-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: nowrap;
      gap: 8px;
      padding: 6px 10px;
    }
    .social-header-h3 { font-size: 14px; white-space: nowrap; }
    .social-links { margin: 0; flex-shrink: 0; }
  }
</style>
