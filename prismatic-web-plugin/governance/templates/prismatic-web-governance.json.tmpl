{
  "schema_version": 1,
  "site": {
    "name": "{{SITE_NAME}}",
    "repo": "{{REPO}}",
    "production_branch": "origin/{{PRODUCTION_BRANCH}}",
    "staging_branch": "origin/{{STAGING_BRANCH}}",
    "legacy_content_branch": {{LEGACY_BRANCH_JSON}},
    "production_url": "{{PRODUCTION_URL}}",
    "staging_url": "{{STAGING_URL}}",
    "homepage_path": "{{HOMEPAGE_PATH}}"
  },
  "policy": {
    "max_open_pr_age_days": 7,
    "max_staging_behind_production_commits": 0,
    "max_production_behind_staging_commits": 0,
    "stale_branch_days": 14,
    "allowed_long_lived_branches": {{ALLOWED_LONG_LIVED_BRANCHES_JSON}},
    "required_production_markers": {{REQUIRED_MARKERS_JSON}},
    "forbidden_production_markers": {{FORBIDDEN_MARKERS_JSON}},
    "protected_paths": [
      "site/_redirects",
      "_redirects",
      "site/robots.txt",
      "site/sitemap.xml",
      "robots.txt",
      "sitemap.xml",
      "PRISMATIC_ENGINE.yaml",
      ".prismatic-web-governance.json"
    ]
  },
  "agents": {
    "kai": {"branch_prefix": "content/", "owner_paths": ["site/", "content/", "okf/", "docs/", "scripts/"]},
    "fred": {"branch_prefix": "feature/", "owner_paths": ["*"]},
    "agy": {"branch_prefix": "design/", "owner_paths": ["assets/", "designs/", "reports/"]},
    "ned": {"branch_prefix": "ned/", "owner_paths": ["src/", "infra/", "deploy/", "scripts/"]},
    "jules": {"branch_prefix": "jules/", "owner_paths": ["docs/"]}
  }
}
