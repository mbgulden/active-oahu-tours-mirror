{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "jquery": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "globals": {
    "dataLayer": "readonly",
    "jQuery": "readonly",
    "$": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-console": "off",
    "prefer-const": "warn",
    "no-var": "warn",
    "eqeqeq": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "strict": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "site/wp-content/",
    "site/wp-includes/"
  ]
}